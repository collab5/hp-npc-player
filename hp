local targetFolder = Instance.new("Folder")
targetFolder.Name = "TargetHealthDisplays"
targetFolder.Parent = PlayerGui

local tracked = {}

--========================================================
-- CREATE TARGET GUI
--========================================================

local function createTargetGUI(
	character,
	humanoid,
	root,
	isPlayer
)

	if not character
		or not humanoid
		or not root then
		return
	end

	if tracked[humanoid] then
		return
	end

	if character == LocalPlayer.Character then
		return
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "HP"
	gui.Size = UDim2.fromOffset(100, 18)

	-- lebih dekat ke kepala
	gui.StudsOffset = Vector3.new(0, 2.6, 0)

	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = MAX_DISTANCE
	gui.Enabled = false
	gui.Adornee = root
	gui.Parent = targetFolder

	--====================================================
	-- BACKGROUND
	--====================================================

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
	bg.BackgroundTransparency = 0.15
	bg.BorderSizePixel = 0
	bg.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 3)
	corner.Parent = bg

	--====================================================
	-- COLOR
	--====================================================

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1

	if isPlayer then
		stroke.Color = Color3.fromRGB(80, 160, 255)
	else
		stroke.Color = Color3.fromRGB(255, 190, 60)
	end

	stroke.Transparency = 0.35
	stroke.Parent = bg

	--====================================================
	-- BAR
	--====================================================

	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0, 2, 0, 2)
	bar.Size = UDim2.new(1, -4, 1, -4)
	bar.BackgroundColor3 = Color3.fromRGB(70, 220, 100)
	bar.BorderSizePixel = 0
	bar.Parent = bg

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 2)
	barCorner.Parent = bar

	--====================================================
	-- TEXT
	--====================================================

	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 9
	text.TextColor3 = Color3.fromRGB(255, 255, 255)
	text.TextStrokeTransparency = 0.45
	text.ZIndex = 5
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.Parent = bg

	--====================================================
	-- UPDATE
	--====================================================

	local healthConnection
	local maxConnection

	local function update()

		if not humanoid.Parent then
			return
		end

		local maxHealth = humanoid.MaxHealth

		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(
			humanoid.Health,
			0,
			maxHealth
		)

		local percent = math.clamp(
			health / maxHealth,
			0,
			1
		)

		bar.Size = UDim2.new(
			percent,
			-4,
			1,
			-4
		)

		text.Text = string.format(
			"%d%%",
			math.floor(percent * 100 + 0.5)
		)

		if percent > 0.6 then

			bar.BackgroundColor3 =
				Color3.fromRGB(70, 220, 100)

		elseif percent > 0.3 then

			bar.BackgroundColor3 =
				Color3.fromRGB(245, 190, 60)

		else

			bar.BackgroundColor3 =
				Color3.fromRGB(235, 65, 65)
		end
	end

	update()

	healthConnection =
		humanoid.HealthChanged:Connect(update)

	maxConnection =
		humanoid:GetPropertyChangedSignal("MaxHealth")
		:Connect(update)

	tracked[humanoid] = {
		gui = gui,
		root = root,
		healthConnection = healthConnection,
		maxConnection = maxConnection
	}

	humanoid.AncestryChanged:Connect(function()

		if not humanoid:IsDescendantOf(game) then

			if healthConnection then
				healthConnection:Disconnect()
			end

			if maxConnection then
				maxConnection:Disconnect()
			end

			if gui then
				gui:Destroy()
			end

			tracked[humanoid] = nil
		end
	end)
end

--========================================================
-- OTHER PLAYERS
--========================================================

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	local function characterAdded(character)

		task.spawn(function()

			local humanoid =
				character:WaitForChild(
					"Humanoid",
					10
				)

			local root =
				character:WaitForChild(
					"HumanoidRootPart",
					10
				)

			if humanoid and root then

				createTargetGUI(
					character,
					humanoid,
					root,
					true
				)
			end
		end)
	end

	if player.Character then
		characterAdded(player.Character)
	end

	player.CharacterAdded:Connect(characterAdded)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
	setupPlayer(player)
end)

--========================================================
-- NPC
--========================================================

local function checkNPC(humanoid)

	if not humanoid:IsA("Humanoid") then
		return
	end

	local character = humanoid.Parent

	if not character
		or not character:IsA("Model") then
		return
	end

	-- Jangan anggap player sebagai NPC
	if Players:GetPlayerFromCharacter(character) then
		return
	end

	if character == LocalPlayer.Character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)
		or character:FindFirstChild(
			"UpperTorso"
		)
		or character:FindFirstChild("Torso")

	if root then

		createTargetGUI(
			character,
			humanoid,
			root,
			false
		)
	end
end

for _, object in ipairs(Workspace:GetDescendants()) do

	if object:IsA("Humanoid") then
		checkNPC(object)
	end
end

Workspace.DescendantAdded:Connect(function(object)

	if object:IsA("Humanoid") then

		task.defer(function()
			checkNPC(object)
		end)
	end
end)

--========================================================
-- DISTANCE OPTIMIZATION
--========================================================

local timer = 0

RunService.Heartbeat:Connect(function(dt)

	timer += dt

	if timer < DISTANCE_UPDATE then
		return
	end

	timer = 0

	local character = LocalPlayer.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	for humanoid, data in pairs(tracked) do

		if not data.root
			or not data.root.Parent then

			if data.gui then
				data.gui:Destroy()
			end

			tracked[humanoid] = nil

			continue
		end

		local distance =
			(data.root.Position - root.Position).Magnitude

		data.gui.Enabled =
			distance <= MAX_DISTANCE
	end
end)

print(
	"[Simple HP] Loaded | Radius:",
	MAX_DISTANCE
)
