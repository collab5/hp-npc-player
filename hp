--========================================================
-- UPDATE LOCAL PLAYER HEALTH
--========================================================

local function setupLocalCharacter(character)
	if localHealthConnection then
		localHealthConnection:Disconnect()
		localHealthConnection = nil
	end

	if maxHealthConnection then
		maxHealthConnection:Disconnect()
		maxHealthConnection = nil
	end

	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end

	local function updateHealth()
		local maxHealth = humanoid.MaxHealth
		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(humanoid.Health, 0, maxHealth)
		local percent = math.clamp(health / maxHealth, 0, 1)
		local percentNumber = math.floor(percent * 100 + 0.5)

		percentText.Text = string.format("%d%%", percentNumber)
		actualText.Text = string.format("%d / %d", math.floor(health + 0.5), math.floor(maxHealth + 0.5))

		local tween = TweenService:Create(
			healthBar,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.new(percent, 0, 1, 0) }
		)
		tween:Play()

		local targetColor
		if percent > 0.6 then
			targetColor = Color3.fromRGB(70, 220, 100)
		elseif percent > 0.3 then
			targetColor = Color3.fromRGB(245, 190, 60)
		else
			targetColor = Color3.fromRGB(235, 65, 65)
		end

		local colorTween = TweenService:Create(
			healthBar,
			TweenInfo.new(0.2),
			{ BackgroundColor3 = targetColor }
		)
		colorTween:Play()

		if percent <= 0.25 and percent > 0 then
			percentText.TextColor3 = Color3.fromRGB(255, 90, 90)
		else
			percentText.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	updateHealth()
	localHealthConnection = humanoid.HealthChanged:Connect(updateHealth)
	maxHealthConnection = humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateHealth)
end

if LocalPlayer.Character then
	task.spawn(function()
		setupLocalCharacter(LocalPlayer.Character)
	end)
end

LocalPlayer.CharacterAdded:Connect(function(character)
	task.spawn(function()
		setupLocalCharacter(character)
	end)
end)

--========================================================
-- OTHER PLAYER / NPC HP BAR
--========================================================

local function getTargetColor(percent)
	if percent > 0.6 then
		return Color3.fromRGB(70, 220, 100)
	elseif percent > 0.3 then
		return Color3.fromRGB(245, 190, 60)
	end
	return Color3.fromRGB(235, 65, 65)
end

local function createEnemyBar(humanoid)
	if not humanoid or trackedHumanoids[humanoid] then
		return
	end

	local model = humanoid.Parent
	if not model or model == LocalPlayer.Character then
		return
	end

	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local billboardGui = Instance.new("BillboardGui")
	billboardGui.Name = "EnemyHealthBar"
	billboardGui.Size = UDim2.fromOffset(120, 16)
	billboardGui.StudsOffset = Vector3.new(0, 3.2, 0)
	billboardGui.AlwaysOnTop = true
	billboardGui.MaxDistance = 120
	billboardGui.Adornee = root
	billboardGui.Parent = PlayerGui

	local background = Instance.new("Frame")
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
	background.BorderSizePixel = 0
	background.Parent = billboardGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = background

	local bar = Instance.new("Frame")
	bar.AnchorPoint = Vector2.new(0, 0.5)
	bar.Position = UDim2.new(0, 2, 0.5, 0)
	bar.Size = UDim2.new(1, -4, 0.7, 0)
	bar.BackgroundColor3 = Color3.fromRGB(70, 220, 100)
	bar.BorderSizePixel = 0
	bar.Parent = background

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 3)
	barCorner.Parent = bar

	local label = Instance.new("TextLabel")
	label.Position = UDim2.new(0, 0, 0, 0)
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 10
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = "100 / 100"
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.Parent = background

	local function updateBar()
		if not humanoid.Parent then
			return
		end

		local maxHealth = humanoid.MaxHealth
		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(humanoid.Health, 0, maxHealth)
		local percent = math.clamp(health / maxHealth, 0, 1)
		bar.Size = UDim2.new(percent, -4, 0.7, 0)
		bar.BackgroundColor3 = getTargetColor(percent)
		label.Text = string.format("%d / %d", math.floor(health + 0.5), math.floor(maxHealth + 0.5))
	end

	updateBar()

	local connections = {
		humanoid.HealthChanged:Connect(updateBar),
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateBar),
		humanoid.AncestryChanged:Connect(function()
			if not humanoid.Parent then
				for _, connection in ipairs(connections) do
					connection:Disconnect()
				end
				trackedHumanoids[humanoid] = nil
				billboardGui:Destroy()
			end
		end)
	}

	trackedHumanoids[humanoid] = {
		gui = billboardGui,
		connections = connections,
	}
end

local function scanCharacters()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("Model") then
			local humanoid = descendant:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Parent ~= LocalPlayer.Character then
				createEnemyBar(humanoid)
			end
		end
	end
end

scanCharacters()

Workspace.DescendantAdded:Connect(function(descendant)
	if descendant:IsA("Model") then
		local humanoid = descendant:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Parent ~= LocalPlayer.Character then
			createEnemyBar(humanoid)
		end
	end
end)

Workspace.DescendantRemoving:Connect(function(descendant)
	if descendant:IsA("Model") then
		local humanoid = descendant:FindFirstChildOfClass("Humanoid")
		if humanoid and trackedHumanoids[humanoid] then
			for _, connection in ipairs(trackedHumanoids[humanoid].connections) do
				connection:Disconnect()
			end
			trackedHumanoids[humanoid].gui:Destroy()
			trackedHumanoids[humanoid] = nil
		end
	end
end)

