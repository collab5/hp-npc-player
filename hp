--========================================================
-- BILLBOARD CREATOR
--========================================================

local function createBillboard(character, humanoid, targetType)

	if not character or not humanoid then
		return
	end

	local head = character:FindFirstChild("Head")
		or character:FindFirstChild("HumanoidRootPart")

	if not head then
		return
	end

	local old = head:FindFirstChild("DarkPvP_HP")

	if old then
		old:Destroy()
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "DarkPvP_HP"
	gui.Size = UDim2.fromOffset(145, 31)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = MAX_DISTANCE
	gui.Enabled = true
	gui.Parent = head

	local main = Instance.new("Frame")
	main.Size = UDim2.fromScale(1, 1)
	main.BackgroundColor3 = DARK
	main.BackgroundTransparency = 0.08
	main.BorderSizePixel = 0
	main.Parent = gui

	round(main, 5)

	local borderColor = RED

	if targetType == "PLAYER" then
		borderColor = PLAYER_RED
	elseif targetType == "NPC" then
		borderColor = NPC_RED
	elseif targetType == "SELF" then
		borderColor = BRIGHT_RED
	end

	stroke(main, borderColor, 1.5)

	-- TYPE
	local typeLabel = Instance.new("TextLabel")
	typeLabel.BackgroundTransparency = 1
	typeLabel.Size = UDim2.new(0.5, 0, 0, 12)
	typeLabel.Position = UDim2.fromOffset(6, 2)
	typeLabel.Text = targetType
	typeLabel.TextColor3 = borderColor
	typeLabel.TextSize = 8
	typeLabel.Font = Enum.Font.GothamBold
	typeLabel.TextXAlignment = Enum.TextXAlignment.Left
	typeLabel.Parent = main

	-- PERCENT
	local percentLabel = Instance.new("TextLabel")
	percentLabel.BackgroundTransparency = 1
	percentLabel.Size = UDim2.new(0.5, -6, 0, 12)
	percentLabel.Position = UDim2.new(0.5, 0, 0, 2)
	percentLabel.Text = "100%"
	percentLabel.TextColor3 = WHITE
	percentLabel.TextSize = 9
	percentLabel.Font = Enum.Font.GothamBold
	percentLabel.TextXAlignment = Enum.TextXAlignment.Right
	percentLabel.Parent = main

	-- BAR BACKGROUND
	local barBG = Instance.new("Frame")
	barBG.Size = UDim2.new(1, -12, 0, 10)
	barBG.Position = UDim2.fromOffset(6, 17)
	barBG.BackgroundColor3 = Color3.fromRGB(35, 8, 10)
	barBG.BorderSizePixel = 0
	barBG.ClipsDescendants = true
	barBG.Parent = main

	round(barBG, 3)

	local bar = Instance.new("Frame")
	bar.Size = UDim2.fromScale(1, 1)
	bar.BackgroundColor3 = borderColor
	bar.BorderSizePixel = 0
	bar.Parent = barBG

	round(bar, 3)

	--====================================================
	-- HEALTH UPDATE
	--====================================================

	local function update()

		if not humanoid.Parent then
			return
		end

		local maxHealth = math.max(humanoid.MaxHealth, 1)
		local health = math.clamp(humanoid.Health, 0, maxHealth)
		local percent = health / maxHealth

		bar.Size = UDim2.fromScale(percent, 1)

		percentLabel.Text = math.floor(percent * 100 + 0.5) .. "%"

		if percent <= 0.25 then
			bar.BackgroundColor3 = BRIGHT_RED
		elseif percent <= 0.5 then
			bar.BackgroundColor3 = RED
		else
			bar.BackgroundColor3 = borderColor
		end
	end

	update()

	local healthConnection
	healthConnection = humanoid.HealthChanged:Connect(update)

	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)

	gui.AncestryChanged:Connect(function(_, parent)
		if not parent then
			if healthConnection then
				healthConnection:Disconnect()
			end
		end
	end)

	return gui
end

--========================================================
-- SELF CHARACTER
--========================================================

local function setupSelf(character)
    -- SELF HP is HUD-only. Remove any legacy SELF billboard left by an older copy.
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Name == "DarkHP_Billboard" then
            obj:Destroy()
        end
    end

	local humanoid = character:WaitForChild("Humanoid", 5)

	if not humanoid then
		return
	end

	local lastHealth = humanoid.Health

	local function updateSelf()

		local maxHealth = math.max(humanoid.MaxHealth, 1)
		local health = math.clamp(humanoid.Health, 0, maxHealth)
		local percent = health / maxHealth

		SelfBar.Size = UDim2.fromScale(percent, 1)

		SelfPercent.Text =
			math.floor(percent * 100 + 0.5) .. "%"

		SelfHPText.Text =
			math.floor(health) .. " / " ..
			math.floor(maxHealth)

		-- Low HP
		if percent <= 0.25 then
			LowHP.BackgroundTransparency = 0.88
		elseif percent <= 0.5 then
			LowHP.BackgroundTransparency = 0.95
		else
			LowHP.BackgroundTransparency = 1
		end

		-- Damage flash
		if health < lastHealth then

			DamageFlash.BackgroundTransparency = 0.82

			TweenService:Create(
				DamageFlash,
				TweenInfo.new(0.25),
				{
					BackgroundTransparency = 1
				}
			):Play()
		end

		lastHealth = health
	end

	updateSelf()

	humanoid.HealthChanged:Connect(updateSelf)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateSelf)
end

--========================================================
-- PLAYER SYSTEM
--========================================================

local playerConnections = {}

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	if playerConnections[player] then
		return
	end

	playerConnections[player] = true

	local function characterAdded(character)

		task.wait(0.5)

		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			createBillboard(
				character,
				humanoid,
				"PLAYER"
			)
		end
	end

	if player.Character then
		task.spawn(characterAdded, player.Character)
	end

	player.CharacterAdded:Connect(characterAdded)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
	playerConnections[player] = nil
end)

--========================================================
-- NPC SYSTEM
--========================================================

local npcConnections = {}

local function setupNPC(model)

	if not model:IsA("Model") then
		return
	end

	-- Jangan anggap karakter player sebagai NPC
	if Players:GetPlayerFromCharacter(model) then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if npcConnections[model] then
		return
	end

	npcConnections[model] = true

	task.spawn(function()

		task.wait(0.1)

		createBillboard(
			model,
			humanoid,
			"NPC"
		)
	end)

	model.AncestryChanged:Connect(function(_, parent)

		if not parent then
			npcConnections[model] = nil
		end
	end)
end

for _, obj in ipairs(Workspace:GetDescendants()) do

	if obj:IsA("Model") then
		setupNPC(obj)
	end
end

Workspace.DescendantAdded:Connect(function(obj)

	if obj:IsA("Model") then
		task.defer(function()
			setupNPC(obj)
		end)
	end
end)

--========================================================
-- DISTANCE OPTIMIZATION
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		local character = LocalPlayer.Character
		local root = character
			and character:FindFirstChild("HumanoidRootPart")

		if root then

			for _, player in ipairs(Players:GetPlayers()) do

				if player ~= LocalPlayer then

					local target = player.Character
					local targetRoot =
						target
						and target:FindFirstChild("HumanoidRootPart")

					if targetRoot then

						local distance =
							(root.Position - targetRoot.Position).Magnitude

						local head = target:FindFirstChild("Head")

						if head then

							local gui =
								head:FindFirstChild("DarkPvP_HP")

							if gui then
								gui.Enabled =
									distance <= MAX_DISTANCE
							end
						end
					end
				end
			end

			-- NPC
			for model, _ in pairs(npcConnections) do

				if model and model.Parent then

					local targetRoot =
						model:FindFirstChild("HumanoidRootPart")

					if targetRoot then

						local distance =
							(root.Position - targetRoot.Position).Magnitude

						local head =
							model:FindFirstChild("Head")
							or targetRoot

						local gui =
							head:FindFirstChild("DarkPvP_HP")

						if gui then
							gui.Enabled =
								distance <= MAX_DISTANCE
						end
					end
				end
			end
		end

		task.wait(DISTANCE_UPDATE)
	end
end)

--========================================================
-- RESPAWN
--========================================================

LocalPlayer.CharacterAdded:Connect(function(character)

	task.wait(0.5)

	setupSelf(character)
end)

if LocalPlayer.Character then
	task.spawn(function()
		setupSelf(LocalPlayer.Character)
	end)
end
