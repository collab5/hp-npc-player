	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	background.BackgroundTransparency = 0.15
	background.BorderSizePixel = 0
	background.Parent = billboard

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 6)
	bgCorner.Parent = background

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Transparency = 0.25
	stroke.Color =
		isPlayer
		and Color3.fromRGB(70, 160, 255)
		or Color3.fromRGB(255, 190, 60)

	stroke.Parent = background

	--====================================================
	-- NAME
	--====================================================

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.new(0, 5, 0, -17)
	nameLabel.Size = UDim2.new(1, -10, 0, 18)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 11
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center

	if isPlayer then
		nameLabel.TextColor3 =
			Color3.fromRGB(100, 190, 255)

		nameLabel.Text = Players:GetPlayerFromCharacter(character).DisplayName

	else
		nameLabel.TextColor3 =
			Color3.fromRGB(255, 210, 90)

		nameLabel.Text = character.Name
	end

	nameLabel.Parent = background

	--====================================================
	-- HP BAR BACKGROUND
	--====================================================

	local barBackground = Instance.new("Frame")
	barBackground.Name = "BarBackground"
	barBackground.Position = UDim2.new(0, 3, 0, 4)
	barBackground.Size = UDim2.new(1, -6, 0, 13)
	barBackground.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
	barBackground.BorderSizePixel = 0
	barBackground.ClipsDescendants = true
	barBackground.Parent = background

	local barBgCorner = Instance.new("UICorner")
	barBgCorner.CornerRadius = UDim.new(0, 4)
	barBgCorner.Parent = barBackground

	--====================================================
	-- HP BAR
	--====================================================

	local bar = Instance.new("Frame")
	bar.Name = "HealthBar"
	bar.Size = UDim2.fromScale(1, 1)
	bar.BackgroundColor3 = Color3.fromRGB(70, 220, 100)
	bar.BorderSizePixel = 0
	bar.Parent = barBackground

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 4)
	barCorner.Parent = bar

	--====================================================
	-- HP TEXT
	--====================================================

	local hpText = Instance.new("TextLabel")
	hpText.Name = "HP"
	hpText.BackgroundTransparency = 1
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.Font = Enum.Font.GothamBold
	hpText.TextSize = 9
	hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
	hpText.TextStrokeTransparency = 0.5
	hpText.TextXAlignment = Enum.TextXAlignment.Center
	hpText.TextYAlignment = Enum.TextYAlignment.Center
	hpText.ZIndex = 5
	hpText.Parent = barBackground

	--====================================================
	-- UPDATE
	--====================================================

	local connections = {}

	local function update()

		if not humanoid.Parent then
			return
		end

		if not root.Parent then
			return
		end

		local maxHealth = humanoid.MaxHealth

		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(
			humanoid.Health,
			0,
			maxHealth
		)

		local percent = math.clamp(
			health / maxHealth,
			0,
			1
		)

		-- PENTING:
		-- jangan pakai UDim2.new(percent, -4, ...)
		-- karena bisa membuat bar error saat HP rendah.
		bar.Size = UDim2.fromScale(percent, 1)

		bar.BackgroundColor3 =
			getHealthColor(percent)

		hpText.Text = string.format(
			"%d%%  |  %d/%d",
			math.floor(percent * 100 + 0.5),
			math.floor(health + 0.5),
			math.floor(maxHealth + 0.5)
		)
	end

	update()

	table.insert(
		connections,
		humanoid.HealthChanged:Connect(update)
	)

	table.insert(
		connections,
		humanoid:GetPropertyChangedSignal("MaxHealth")
			:Connect(update)
	)

	--====================================================
	-- CLEANUP
	--====================================================

	table.insert(
		connections,
		humanoid.AncestryChanged:Connect(function()

			if not humanoid:IsDescendantOf(game) then

				for _, connection in ipairs(connections) do
					connection:Disconnect()
				end

				tracked[humanoid] = nil

				if billboard then
					billboard:Destroy()
				end
			end
		end)
	)

	tracked[humanoid] = {
		gui = billboard,
		character = character,
		root = root,
		humanoid = humanoid,
		isPlayer = isPlayer
	}
end

--========================================================
-- CREATE PLAYER TARGET
--========================================================

local function setupOtherPlayer(player)

	if player == LocalPlayer then
		return
	end

	local function setupCharacter(character)

		task.spawn(function()

			local humanoid =
				character:WaitForChild("Humanoid", 10)

			local root =
				character:WaitForChild(
					"HumanoidRootPart",
					10
				)

			if not humanoid or not root then
				return
			end

			-- Pastikan bukan karakter sendiri
			if player == LocalPlayer then
				return
			end

			createHealthGui(
				character,
				humanoid,
				root,
				true
			)
		end)
	end

	-- Karakter yang sudah ada
	if player.Character then
		setupCharacter(player.Character)
	end

	-- Karakter baru / respawn
	player.CharacterAdded:Connect(setupCharacter)
end

