--========================================================
-- LOCAL PLAYER HEALTH
--========================================================

local localHealthConnection
local localMaxHealthConnection

local function setupLocalCharacter(character)

	if localHealthConnection then
		localHealthConnection:Disconnect()
		localHealthConnection = nil
	end

	if localMaxHealthConnection then
		localMaxHealthConnection:Disconnect()
		localMaxHealthConnection = nil
	end

	local humanoid = character:WaitForChild("Humanoid", 10)

	if not humanoid then
		return
	end

	local function updateLocalHealth()

		local maxHealth = humanoid.MaxHealth

		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(humanoid.Health, 0, maxHealth)
		local percent = math.clamp(health / maxHealth, 0, 1)

		percentText.Text = string.format(
			"%d%%",
			math.floor(percent * 100 + 0.5)
		)

		actualText.Text = string.format(
			"%d / %d",
			math.floor(health + 0.5),
			math.floor(maxHealth + 0.5)
		)

		TweenService:Create(
			healthBar,
			TweenInfo.new(0.15),
			{
				Size = UDim2.fromScale(percent, 1)
			}
		):Play()

		if percent > 0.6 then

			healthBar.BackgroundColor3 =
				Color3.fromRGB(70, 220, 100)

		elseif percent > 0.3 then

			healthBar.BackgroundColor3 =
				Color3.fromRGB(245, 190, 60)

		else

			healthBar.BackgroundColor3 =
				Color3.fromRGB(235, 65, 65)

		end
	end

	updateLocalHealth()

	localHealthConnection =
		humanoid.HealthChanged:Connect(updateLocalHealth)

	localMaxHealthConnection =
		humanoid:GetPropertyChangedSignal("MaxHealth")
		:Connect(updateLocalHealth)
end

if LocalPlayer.Character then
	task.spawn(function()
		setupLocalCharacter(LocalPlayer.Character)
	end)
end

LocalPlayer.CharacterAdded:Connect(function(character)
	task.spawn(function()
		setupLocalCharacter(character)
	end)
end)

