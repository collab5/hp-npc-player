local function getDeviceName()
	if UserInputService.GamepadEnabled then
		return "Gamepad"
	elseif UserInputService.TouchEnabled then
		return "Mobile / Touch"
	else
		return "PC / Keyboard"
	end
end

local function getLocaleName()
	local locale = LocalizationService.RobloxLocaleId
	if typeof(locale) == "string" and locale ~= "" then
		return locale
	end
	return "Unknown"
end

