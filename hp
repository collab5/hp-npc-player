--========================================================
-- PLAYER LAIN + NPC HP GUI
-- CLIENT SIDE
--========================================================

local MAX_HP_BAR_DISTANCE = 80
local DISTANCE_CHECK_INTERVAL = 0.2

local trackedHumanoids = {}

local function getHealthColor(percent)
	if percent > 0.60 then
		return Color3.fromRGB(70, 220, 100)
	elseif percent > 0.30 then
		return Color3.fromRGB(245, 190, 60)
	else
		return Color3.fromRGB(235, 65, 65)
	end
end

local function getRoot(character)
	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("Head")
end

local function removeHealthGui(humanoid)
	local data = trackedHumanoids[humanoid]

	if not data then
		return
	end

	trackedHumanoids[humanoid] = nil

	if data.connections then
		for _, connection in ipairs(data.connections) do
			if connection then
				connection:Disconnect()
			end
		end
	end

	if data.gui then
		data.gui:Destroy()
	end
end

local function createPlayerHealthGui(character)

	if not character then
		return
	end

	-- Jangan tampilkan HP diri sendiri
	if character == LocalPlayer.Character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		humanoid = character:WaitForChild("Humanoid", 5)
	end

	if not humanoid then
		return
	end

	if trackedHumanoids[humanoid] then
		return
	end

	local root = getRoot(character)

	if not root then
		root = character:WaitForChild("HumanoidRootPart", 5)
	end

	if not root then
		return
	end

	--====================================================
	-- CEK PLAYER ATAU NPC
	--====================================================

	local player = Players:GetPlayerFromCharacter(character)

	local isPlayer = player ~= nil

	--====================================================
	-- BILLBOARD
	--====================================================

	local gui = Instance.new("BillboardGui")

	if isPlayer then
		gui.Name = "OtherPlayerHealth"
	else
		gui.Name = "NPCHealth"
	end

	gui.Adornee = root
	gui.Size = UDim2.fromOffset(150, 38)
	gui.StudsOffset = Vector3.new(0, 3.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = MAX_HP_BAR_DISTANCE

	-- Awalnya mati sampai dicek jarak
	gui.Enabled = false

	gui.Parent = PlayerGui

	--====================================================
	-- BACKGROUND
	--====================================================

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	background.BackgroundTransparency = 0.1
	background.BorderSizePixel = 0
	background.ClipsDescendants = true
	background.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = background

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1

	if isPlayer then
		stroke.Color = Color3.fromRGB(80, 170, 255)
	else
		stroke.Color = Color3.fromRGB(255, 190, 60)
	end

	stroke.Transparency = 0.5
	stroke.Parent = background

	--====================================================
	-- NAME
	--====================================================

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.Position = UDim2.new(0, 7, 0, 2)
	nameLabel.Size = UDim2.new(1, -14, 0, 13)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 10
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd

	if isPlayer then
		nameLabel.Text = player.DisplayName
		nameLabel.TextColor3 = Color3.fromRGB(170, 220, 255)
	else
		nameLabel.Text = character.Name
		nameLabel.TextColor3 = Color3.fromRGB(255, 215, 120)
	end

	nameLabel.Parent = background

	--====================================================
	-- BAR BACKGROUND
	--====================================================

	local barBackground = Instance.new("Frame")
	barBackground.Name = "BarBackground"
	barBackground.Position = UDim2.new(0, 7, 0, 17)
	barBackground.Size = UDim2.new(1, -14, 0, 8)
	barBackground.BackgroundColor3 = Color3.fromRGB(45, 45, 48)
	barBackground.BorderSizePixel = 0
	barBackground.ClipsDescendants = true
	barBackground.Parent = background

	local barBgCorner = Instance.new("UICorner")
	barBgCorner.CornerRadius = UDim.new(1, 0)
	barBgCorner.Parent = barBackground

	--====================================================
	-- HP BAR
	--====================================================

	local hpBar = Instance.new("Frame")
	hpBar.Name = "HPBar"
	hpBar.Size = UDim2.fromScale(1, 1)
	hpBar.BackgroundColor3 = Color3.fromRGB(70, 220, 100)
	hpBar.BorderSizePixel = 0
	hpBar.Parent = barBackground

	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(1, 0)
	hpCorner.Parent = hpBar

	--====================================================
	-- PERCENT
	--====================================================

	local percentLabel = Instance.new("TextLabel")
	percentLabel.Name = "Percent"
	percentLabel.Position = UDim2.new(0, 0, 0, 27)
	percentLabel.Size = UDim2.new(1, 0, 0, 10)
	percentLabel.BackgroundTransparency = 1
	percentLabel.Font = Enum.Font.GothamBold
	percentLabel.TextSize = 9
	percentLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	percentLabel.TextXAlignment = Enum.TextXAlignment.Center
	percentLabel.Parent = background

	--====================================================
	-- UPDATE HP
	--====================================================

	local function updateHealth()

		if not humanoid.Parent then
			return
		end

		local maxHealth = humanoid.MaxHealth

		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(
			humanoid.Health,
			0,
			maxHealth
		)

		local percent = math.clamp(
			health / maxHealth,
			0,
			1
		)

		hpBar.Size = UDim2.fromScale(
			percent,
			1
		)

		hpBar.BackgroundColor3 = getHealthColor(percent)

		percentLabel.Text = string.format(
			"%d%%  |  %d / %d",
			math.floor(percent * 100 + 0.5),
			math.floor(health + 0.5),
			math.floor(maxHealth + 0.5)
		)

	end

	updateHealth()

	--====================================================
	-- CONNECTION
	--====================================================

	local connections = {}

	table.insert(
		connections,
		humanoid.HealthChanged:Connect(updateHealth)
	)

	table.insert(
		connections,
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateHealth)
	)

	table.insert(
		connections,
		humanoid.Died:Connect(function()
			removeHealthGui(humanoid)
		end)
	)

	table.insert(
		connections,
		humanoid.AncestryChanged:Connect(function()
			if not humanoid.Parent then
				removeHealthGui(humanoid)
			end
		end)
	)

	table.insert(
		connections,
		character.AncestryChanged:Connect(function()
			if not character.Parent then
				removeHealthGui(humanoid)
			end
		end)
	)

	trackedHumanoids[humanoid] = {
		gui = gui,
		root = root,
		character = character,
		connections = connections,
		isPlayer = isPlayer
	}

end

--========================================================
-- PLAYER LAIN
--========================================================

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	local function onCharacter(character)

		task.wait(0.2)

		createPlayerHealthGui(character)

	end

	-- Character sudah ada
	if player.Character then
		task.spawn(function()
			onCharacter(player.Character)
		end)
	end

	-- Character baru / respawn
	player.CharacterAdded:Connect(onCharacter)

end

-- Player yang sudah ada
for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

-- Player yang baru join
Players.PlayerAdded:Connect(function(player)
	setupPlayer(player)
end)

--========================================================
-- NPC
--========================================================

local function checkNPC(instance)

	if not instance:IsA("Model") then
		return
	end

	-- Kalau ini karakter player, jangan diproses sebagai NPC
	if Players:GetPlayerFromCharacter(instance) then
		return
	end

	local humanoid = instance:FindFirstChildOfClass("Humanoid")

	if humanoid then
		createPlayerHealthGui(instance)
	end

end

-- NPC yang sudah ada
for _, instance in ipairs(Workspace:GetDescendants()) do
	checkNPC(instance)
end

-- NPC yang baru muncul
Workspace.DescendantAdded:Connect(function(instance)

	if instance:IsA("Model") then

		task.defer(function()
			checkNPC(instance)
		end)

	elseif instance:IsA("Humanoid") then

		task.defer(function()

			local character = instance.Parent

			if character
				and character:IsA("Model")
				and not Players:GetPlayerFromCharacter(character) then

				createPlayerHealthGui(character)

			end

		end)

	end

end)

--========================================================
-- DISTANCE OPTIMIZATION
--========================================================

local distanceTimer = 0

RunService.Heartbeat:Connect(function(deltaTime)

	distanceTimer += deltaTime

	if distanceTimer < DISTANCE_CHECK_INTERVAL then
		return
	end

	distanceTimer = 0

	local localCharacter = LocalPlayer.Character

	if not localCharacter then
		return
	end

	local localRoot = getRoot(localCharacter)

	if not localRoot then
		return
	end

	local localPosition = localRoot.Position

	for humanoid, data in pairs(trackedHumanoids) do

		if not humanoid.Parent then

			removeHealthGui(humanoid)

			continue
		end

		local rootPart = data.root

		if not rootPart or not rootPart.Parent then

			removeHealthGui(humanoid)

			continue
		end

		local distance = (
			rootPart.Position - localPosition
		).Magnitude

		if distance <= MAX_HP_BAR_DISTANCE then

			data.gui.Enabled = true

		else

			data.gui.Enabled = false

		end

	end

end)
