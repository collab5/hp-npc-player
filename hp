--========================================================
-- NPC DETECTION
--========================================================

local function tryCreateNPC(object)

	if not object:IsA("Humanoid") then
		return
	end

	local humanoid = object
	local character = humanoid.Parent

	if not character then
		return
	end

	if not character:IsA("Model") then
		return
	end

	-- Kalau Humanoid ini milik player,
	-- biarkan sistem PlayerAdded yang menangani.
	local player = Players:GetPlayerFromCharacter(character)

	if player then
		return
	end

	if character == LocalPlayer.Character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")

	if not root then
		task.delay(0.5, function()

			if humanoid.Parent then

				local newRoot =
					character:FindFirstChild(
						"HumanoidRootPart"
					)
					or character:FindFirstChild("Torso")
					or character:FindFirstChild("UpperTorso")

				if newRoot then
					createHealthGui(
						character,
						humanoid,
						newRoot,
						false
					)
				end
			end
		end)

		return
	end

	createHealthGui(
		character,
		humanoid,
		root,
		false
	)
end

-- Scan NPC yang sudah ada
for _, object in ipairs(Workspace:GetDescendants()) do
	if object:IsA("Humanoid") then
		tryCreateNPC(object)
	end
end

-- NPC yang baru spawn
Workspace.DescendantAdded:Connect(function(object)

	if object:IsA("Humanoid") then
		task.defer(function()
			tryCreateNPC(object)
		end)
	end

end)

--========================================================
-- DISTANCE OPTIMIZATION
--========================================================

local distanceTimer = 0

RunService.Heartbeat:Connect(function(deltaTime)

	distanceTimer += deltaTime

	if distanceTimer < UPDATE_DISTANCE_INTERVAL then
		return
	end

	distanceTimer = 0

	local localCharacter = LocalPlayer.Character

	if not localCharacter then
		return
	end

	local localRoot =
		localCharacter:FindFirstChild("HumanoidRootPart")

	if not localRoot then
		return
	end

	local localPosition = localRoot.Position

	for humanoid, data in pairs(tracked) do

		if not humanoid.Parent
			or not data.root
			or not data.root.Parent then

			if data.gui then
				data.gui:Destroy()
			end

			tracked[humanoid] = nil

			continue
		end

		local distance =
			(data.root.Position - localPosition).Magnitude

		local shouldShow =
			distance <= MAX_DISTANCE

		if data.gui.Enabled ~= shouldShow then
			data.gui.Enabled = shouldShow
		end
	end
end)

print(
	"[HP SYSTEM] Loaded successfully | Player + NPC | Distance:",
	MAX_DISTANCE
)

