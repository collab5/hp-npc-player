--========================================================
-- HEALTH COLOR
--========================================================

local function getHealthColor(percent)

	if percent > 0.6 then
		return Color3.fromRGB(70, 220, 100)

	elseif percent > 0.3 then
		return Color3.fromRGB(245, 190, 60)

	else
		return Color3.fromRGB(235, 65, 65)
	end
end

--========================================================
-- CREATE TARGET HP GUI
--========================================================

local function createHealthGui(character, humanoid, root, isPlayer)

	if not character then
		return
