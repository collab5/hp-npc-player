--========================================================
-- OTHER PLAYER / NPC HP BAR
-- OPTIMIZED + DISTANCE LIMIT
--========================================================

local MAX_HP_BAR_DISTANCE = 80
local DISTANCE_CHECK_INTERVAL = 0.2

local trackedHumanoids = {}
local distanceTimer = 0

--========================================================
-- COLOR
--========================================================

local function getTargetColor(percent)

	if percent > 0.60 then
		return Color3.fromRGB(70, 220, 100)

	elseif percent > 0.30 then
		return Color3.fromRGB(245, 190, 60)

	else
		return Color3.fromRGB(235, 65, 65)
	end
end

--========================================================
-- CHECK PLAYER CHARACTER
--========================================================

local function isPlayerCharacter(model)

	if not model then
		return false
	end

	for _, player in ipairs(Players:GetPlayers()) do

		if player.Character == model then
			return true
		end

	end

	return false
end

--========================================================
-- REMOVE HP BAR
--========================================================

local function removeHealthBar(humanoid)

	local data = trackedHumanoids[humanoid]

	if not data then
		return
	end

	if data.connections then

		for _, connection in ipairs(data.connections) do

			if connection then
				connection:Disconnect()
			end

		end

	end

	if data.gui then
		data.gui:Destroy()
	end

	trackedHumanoids[humanoid] = nil
end

--========================================================
-- CREATE HP BAR
--========================================================

local function createEnemyBar(humanoid)

	if not humanoid then
		return
	end

	if trackedHumanoids[humanoid] then
		return
	end

	local model = humanoid.Parent

	if not model or not model:IsA("Model") then
		return
	end

	-- Jangan tampilkan HP karakter sendiri
	if model == LocalPlayer.Character then
		return
	end

	-- Pastikan bukan karakter player sendiri
	if isPlayerCharacter(model) and model == LocalPlayer.Character then
		return
	end

	local root = model:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head")

	if not root then
		return
	end

	-- Head tidak wajib.
	-- Kalau tidak ada Head, GUI ditempel ke RootPart.
	local adornee = head or root

	--====================================================
	-- BILLBOARD
	--====================================================

	local billboardGui = Instance.new("BillboardGui")

	billboardGui.Name = "EnemyHealthBar"

	billboardGui.Size = UDim2.fromOffset(125, 32)

	billboardGui.StudsOffset = Vector3.new(
		0,
		head and 3.2 or 2.8,
		0
	)

	billboardGui.AlwaysOnTop = true

	billboardGui.MaxDistance = MAX_HP_BAR_DISTANCE

	billboardGui.Adornee = adornee

	-- Jangan langsung aktif
	billboardGui.Enabled = false

	-- Parent ke PlayerGui karena client-side
	billboardGui.Parent = PlayerGui

	--====================================================
	-- BACKGROUND
	--====================================================

	local background = Instance.new("Frame")

	background.Name = "Background"

	background.AnchorPoint = Vector2.new(0.5, 0.5)

	background.Position = UDim2.fromScale(0.5, 0.5)

	background.Size = UDim2.fromScale(1, 0.75)

	background.BackgroundColor3 =
		Color3.fromRGB(18, 18, 22)

	background.BackgroundTransparency = 0.1

	background.BorderSizePixel = 0

	background.ClipsDescendants = true

	background.Parent = billboardGui

	local backgroundCorner = Instance.new("UICorner")

	backgroundCorner.CornerRadius =
		UDim.new(0, 5)

	backgroundCorner.Parent = background

	--====================================================
	-- BAR BACKGROUND
	--====================================================

	local barBackground = Instance.new("Frame")

	barBackground.Name = "BarBackground"

	barBackground.AnchorPoint =
		Vector2.new(0.5, 0.5)

	barBackground.Position =
		UDim2.fromScale(0.5, 0.5)

	barBackground.Size =
		UDim2.new(1, -6, 0, 12)

	barBackground.BackgroundColor3 =
		Color3.fromRGB(45, 45, 48)

	barBackground.BorderSizePixel = 0

	barBackground.Parent = background

	local barBackgroundCorner = Instance.new("UICorner")

	barBackgroundCorner.CornerRadius =
		UDim.new(1, 0)

	barBackgroundCorner.Parent =
		barBackground

	--====================================================
	-- HEALTH BAR
	--====================================================

	local bar = Instance.new("Frame")

	bar.Name = "HealthBar"

	bar.AnchorPoint =
		Vector2.new(0, 0.5)

	bar.Position =
		UDim2.new(0, 2, 0.5, 0)

	bar.Size =
		UDim2.new(1, -4, 0, 8)

	bar.BackgroundColor3 =
		Color3.fromRGB(70, 220, 100)

	bar.BorderSizePixel = 0

	bar.Parent = barBackground

	local barCorner = Instance.new("UICorner")

	barCorner.CornerRadius =
		UDim.new(1, 0)

	barCorner.Parent = bar

	--====================================================
	-- HP TEXT
	--====================================================

	local label = Instance.new("TextLabel")

	label.Name = "HealthText"

	label.AnchorPoint =
		Vector2.new(0.5, 0.5)

	label.Position =
		UDim2.fromScale(0.5, 0.5)

	label.Size =
		UDim2.fromScale(1, 1)

	label.BackgroundTransparency = 1

	label.Font =
		Enum.Font.GothamBold

	label.TextSize = 10

	label.TextColor3 =
		Color3.fromRGB(255, 255, 255)

	label.TextStrokeTransparency = 0

	label.TextStrokeColor3 =
		Color3.fromRGB(0, 0, 0)

	label.Text =
		"100%"

	label.ZIndex = 5

	label.Parent = background

	--====================================================
	-- UPDATE
	--====================================================

	local function updateBar()

		if not humanoid.Parent then
			return
		end

		local maxHealth =
			humanoid.MaxHealth

		if maxHealth <= 0 then
			return
		end

		local health =
			math.clamp(
				humanoid.Health,
				0,
				maxHealth
			)

		local percent =
			math.clamp(
				health / maxHealth,
				0,
				1
			)

		local percentNumber =
			math.floor(
				percent * 100 + 0.5
			)

		-- Jangan pakai offset negatif
		-- supaya tidak error saat HP = 0
		bar.Size =
			UDim2.new(
				percent,
				-4 * percent,
				0,
				8
			)

		bar.BackgroundColor3 =
			getTargetColor(percent)

		label.Text =
			string.format(
				"%d%%",
				percentNumber
			)
	end

	--====================================================
	-- CONNECTIONS
	--====================================================

	local connections = {}

	connections[#connections + 1] =
		humanoid.HealthChanged:Connect(
			updateBar
		)

	connections[#connections + 1] =
		humanoid:GetPropertyChangedSignal(
			"MaxHealth"
		):Connect(
			updateBar
		)

	connections[#connections + 1] =
		humanoid.AncestryChanged:Connect(
			function()

				if not humanoid.Parent then
					removeHealthBar(humanoid)
				end

			end
		)

	--====================================================
	-- STORE
	--====================================================

	trackedHumanoids[humanoid] = {

		gui = billboardGui,

		model = model,

		root = root,

		connections = connections
	}

	updateBar()
end

--========================================================
-- SCAN
--========================================================

local function scanCharacters()

	for _, descendant in ipairs(
		Workspace:GetDescendants()
	) do

		if descendant:IsA("Humanoid") then

			local model =
				descendant.Parent

			if model
				and model ~= LocalPlayer.Character
				and model:IsA("Model")
			then

				createEnemyBar(descendant)

			end
		end
	end
end

scanCharacters()

--========================================================
-- NEW NPC / PLAYER
--========================================================

Workspace.DescendantAdded:Connect(
	function(descendant)

		if descendant:IsA("Humanoid") then

			task.defer(
				function()

					if descendant.Parent then
						createEnemyBar(descendant)
					end

				end
			)

		end
	end
)

--========================================================
-- DISTANCE OPTIMIZATION
--========================================================

RunService.Heartbeat:Connect(
	function(deltaTime)

		distanceTimer += deltaTime

		if distanceTimer <
			DISTANCE_CHECK_INTERVAL
		then
			return
		end

		distanceTimer = 0

		local character =
			LocalPlayer.Character

		if not character then
			return
		end

		local localRoot =
			character:FindFirstChild(
				"HumanoidRootPart"
			)

		if not localRoot then
			return
		end

		local myPosition =
			localRoot.Position

		for humanoid, data in
			pairs(trackedHumanoids)
		do

			if not humanoid.Parent
				or not data.model
				or not data.model.Parent
			then

				removeHealthBar(humanoid)

				continue
			end

			local targetRoot =
				data.model:FindFirstChild(
					"HumanoidRootPart"
				)

			if not targetRoot then

				data.gui.Enabled = false

				continue
			end

			local distance =
				(
					targetRoot.Position
					- myPosition
				).Magnitude

			-- Hanya aktif dalam radius
			data.gui.Enabled =
				distance <= MAX_HP_BAR_DISTANCE
		end
	end
)
