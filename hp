--========================================================
-- LOCAL PLAYER HEALTH
--========================================================

local localHealthConnection
local localMaxConnection

local function setupLocalHealth(character)

	if localHealthConnection then
		localHealthConnection:Disconnect()
		localHealthConnection = nil
	end

	if localMaxConnection then
		localMaxConnection:Disconnect()
		localMaxConnection = nil
	end

	local humanoid = character:WaitForChild("Humanoid", 10)

	if not humanoid then
		return
	end

	local function update()

		local maxHealth = humanoid.MaxHealth

		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(
			humanoid.Health,
			0,
			maxHealth
		)

		local percent = math.clamp(
			health / maxHealth,
			0,
			1
		)

		localPercent.Text = string.format(
			"%d%%",
			math.floor(percent * 100 + 0.5)
		)

		localBar.Size = UDim2.fromScale(
			percent,
			1
		)

		if percent > 0.6 then

			localBar.BackgroundColor3 =
				Color3.fromRGB(70, 220, 100)

			localStroke.Color =
				Color3.fromRGB(80, 220, 110)

		elseif percent > 0.3 then

			localBar.BackgroundColor3 =
				Color3.fromRGB(245, 190, 60)

			localStroke.Color =
				Color3.fromRGB(245, 190, 60)

		else

			localBar.BackgroundColor3 =
				Color3.fromRGB(235, 65, 65)

			localStroke.Color =
				Color3.fromRGB(235, 65, 65)
		end
	end

	update()

	localHealthConnection =
		humanoid.HealthChanged:Connect(update)

	localMaxConnection =
		humanoid:GetPropertyChangedSignal("MaxHealth")
		:Connect(update)
end

if LocalPlayer.Character then
	task.spawn(function()
		setupLocalHealth(LocalPlayer.Character)
	end)
end

LocalPlayer.CharacterAdded:Connect(function(character)

	task.spawn(function()
		setupLocalHealth(character)
	end)
end)

--========================================================
-- TARGET GUI
