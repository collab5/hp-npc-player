--========================================================
-- TARGET HP GUI
-- TANPA CoreGui
--========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local MAX_DISTANCE = 100
local tracked = {}

-- Folder khusus GUI HP
local targetFolder = PlayerGui:FindFirstChild("TargetHealthDisplays")

if targetFolder then
	targetFolder:Destroy()
end

targetFolder = Instance.new("Folder")
targetFolder.Name = "TargetHealthDisplays"
targetFolder.Parent = PlayerGui

--========================================================
-- BUAT HP GUI
--========================================================

local function createHP(character, humanoid, root, isPlayer)

	if not character or not humanoid or not root then
		return
	end

	if tracked[humanoid] then
		return
	end

	if character == LocalPlayer.Character then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HPDisplay"
	billboard.Size = UDim2.fromOffset(150, 32)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = MAX_DISTANCE
	billboard.Adornee = root
	billboard.Enabled = false

	-- PENTING: PlayerGui, BUKAN CoreGui
	billboard.Parent = targetFolder

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	background.BackgroundTransparency = 0.15
	background.BorderSizePixel = 0
	background.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = background

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = isPlayer
		and Color3.fromRGB(70, 170, 255)
		or Color3.fromRGB(255, 200, 70)
	stroke.Parent = background

	-- Nama
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Position = UDim2.new(0, 0, 0, -17)
	name.Size = UDim2.new(1, 0, 0, 16)
	name.Font = Enum.Font.GothamBold
	name.TextSize = 11
	name.TextStrokeTransparency = 0.5
	name.TextXAlignment = Enum.TextXAlignment.Center

	if isPlayer then
		local player = Players:GetPlayerFromCharacter(character)

		if player then
			name.Text = player.DisplayName
			name.TextColor3 = Color3.fromRGB(100, 190, 255)
		else
			name.Text = character.Name
		end
	else
		name.Text = character.Name
		name.TextColor3 = Color3.fromRGB(255, 210, 90)
	end

	name.Parent = background

	-- Background HP
	local hpBackground = Instance.new("Frame")
	hpBackground.Position = UDim2.new(0, 3, 0, 4)
	hpBackground.Size = UDim2.new(1, -6, 0, 13)
	hpBackground.BackgroundColor3 = Color3.fromRGB(45, 45, 48)
	hpBackground.BorderSizePixel = 0
	hpBackground.ClipsDescendants = true
	hpBackground.Parent = background

	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(0, 4)
	hpCorner.Parent = hpBackground

	-- Bar HP
	local hpBar = Instance.new("Frame")
	hpBar.Size = UDim2.fromScale(1, 1)
	hpBar.BackgroundColor3 = Color3.fromRGB(70, 220, 100)
	hpBar.BorderSizePixel = 0
	hpBar.Parent = hpBackground

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 4)
	barCorner.Parent = hpBar

	-- Text HP
	local hpText = Instance.new("TextLabel")
	hpText.BackgroundTransparency = 1
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.Font = Enum.Font.GothamBold
	hpText.TextSize = 9
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0.5
	hpText.ZIndex = 5
	hpText.TextXAlignment = Enum.TextXAlignment.Center
	hpText.Parent = hpBackground

	--====================================================
	-- UPDATE HP
	--====================================================

	local function updateHP()

		if not humanoid.Parent then
			return
		end

		local maxHealth = humanoid.MaxHealth

		if maxHealth <= 0 then
			return
		end

		local health = math.clamp(
			humanoid.Health,
			0,
			maxHealth
		)

		local percent = math.clamp(
			health / maxHealth,
			0,
			1
		)

		hpBar.Size = UDim2.fromScale(percent, 1)

		if percent > 0.6 then
			hpBar.BackgroundColor3 =
				Color3.fromRGB(70, 220, 100)

		elseif percent > 0.3 then
			hpBar.BackgroundColor3 =
				Color3.fromRGB(245, 190, 60)

		else
			hpBar.BackgroundColor3 =
				Color3.fromRGB(235, 65, 65)
		end

		hpText.Text = string.format(
			"%d%% | %d/%d",
			math.floor(percent * 100 + 0.5),
			math.floor(health + 0.5),
			math.floor(maxHealth + 0.5)
		)
	end

	updateHP()

	local healthConnection =
		humanoid.HealthChanged:Connect(updateHP)

	local maxConnection =
		humanoid:GetPropertyChangedSignal("MaxHealth")
		:Connect(updateHP)

	tracked[humanoid] = {
		gui = billboard,
		root = root,
		healthConnection = healthConnection,
		maxConnection = maxConnection
	}

	-- Cleanup
	humanoid.AncestryChanged:Connect(function()

		if not humanoid:IsDescendantOf(game) then

			if healthConnection then
				healthConnection:Disconnect()
			end

			if maxConnection then
				maxConnection:Disconnect()
			end

			if billboard then
				billboard:Destroy()
			end

			tracked[humanoid] = nil
		end
	end)
end

--========================================================
-- PLAYER LAIN
--========================================================

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	local function setupCharacter(character)

		task.spawn(function()

			local humanoid =
				character:WaitForChild("Humanoid", 10)

			local root =
				character:WaitForChild(
					"HumanoidRootPart",
					10
				)

			if humanoid and root then
				createHP(
					character,
					humanoid,
					root,
					true
				)
			end
		end)
	end

	if player.Character then
		setupCharacter(player.Character)
	end

	player.CharacterAdded:Connect(setupCharacter)
end

-- Player yang sudah ada
for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

-- Player yang baru masuk
Players.PlayerAdded:Connect(function(player)
	setupPlayer(player)
end)

--========================================================
-- NPC
--========================================================

local function checkNPC(humanoid)

	if not humanoid:IsA("Humanoid") then
		return
	end

	local character = humanoid.Parent

	if not character or not character:IsA("Model") then
		return
	end

	-- Jangan diproses sebagai NPC kalau sebenarnya player
	if Players:GetPlayerFromCharacter(character) then
		return
	end

	if character == LocalPlayer.Character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")

	if root then
		createHP(
			character,
			humanoid,
			root,
			false
		)
	end
end

-- NPC yang sudah ada
for _, object in ipairs(Workspace:GetDescendants()) do
	if object:IsA("Humanoid") then
		checkNPC(object)
	end
end

-- NPC baru
Workspace.DescendantAdded:Connect(function(object)

	if object:IsA("Humanoid") then
		task.defer(function()
			checkNPC(object)
		end)
	end
end)

--========================================================
-- DISTANCE
--========================================================

local timer = 0

RunService.Heartbeat:Connect(function(dt)

	timer += dt

	if timer < 0.2 then
		return
	end

	timer = 0

	local character = LocalPlayer.Character

	if not character then
		return
	end

	local localRoot =
		character:FindFirstChild("HumanoidRootPart")

	if not localRoot then
		return
	end

	for humanoid, data in pairs(tracked) do

		if not data.root or not data.root.Parent then

			if data.gui then
				data.gui:Destroy()
			end

			tracked[humanoid] = nil

			continue
		end

		local distance =
			(data.root.Position - localRoot.Position).Magnitude

		data.gui.Enabled =
			distance <= MAX_DISTANCE
	end
end)

print("[HP] Player/NPC HP GUI loaded")
